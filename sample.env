# ── Required Bot & Telegram Credentials ──────────────────────────────────
API_ID=                                # Telegram API ID from https://my.telegram.org
API_HASH=                              # Telegram API Hash from https://my.telegram.org
BOT_TOKEN=                             # Telegram Bot Token from @BotFather
OWNER_ID=                              # Numeric User ID of the Bot Owner
LOGGER_ID=                             # Channel/Group ID for system logs & error alerts (e.g. -100xxxxxxxxxx)

# ── Database ─────────────────────────────────────────────────────────────
MONGO_DB_URI=                          # MongoDB Atlas URI (mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority)

# ── Assistant Userbot Session (Pyrogram v2) ──────────────────────────────
STRING_SESSION=                        # Pyrogram V2 String Session for voice chat assistant
STRING_SESSION2=                       # (Optional) Multi-assistant session 2
STRING_SESSION3=                       # (Optional) Multi-assistant session 3

# ── Optional Streaming Platforms (For High-Fidelity Resolvers) ───────────
SPOTIFY_CLIENT_ID=                     # (Optional) Spotify Developer Client ID
SPOTIFY_CLIENT_SECRET=                 # (Optional) Spotify Developer Client Secret

# ── Bot Customization & Tuning ───────────────────────────────────────────
BOT_USERNAME=                          # (Optional) Your Bot Username without @
DURATION_LIMIT=54000                   # Maximum playback duration limit in minutes
SONG_DOWNLOAD_DURATION_LIMIT=54000     # Maximum song download duration in minutes
AUTO_LEAVING_ASSISTANT=False           # Automatically leave voice chats when inactive
AUTO_SUGGESTION_MODE=True              # Enable smart autoplay when queue ends
CLEANMODE_MINS=5                       # Automatically delete command messages after N minutes

# ── Deployment & Cloud Hosting ───────────────────────────────────────────
HEROKU_APP_NAME=                       # (Heroku only) Heroku app name
HEROKU_API_KEY=                        # (Heroku only) Heroku API key
RENDER=False                           # Set to True on Render to enable background keepalive server
PING_URL=                              # (Optional) Health check ping URL
